{
  "name": "prompt-canary",
  "version": "0.1.0",
  "private": true,
  "description": "Progressive delivery for LLM prompts on Cloudflare: SLO-gated canary rollouts with automatic rollback.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types",
    "db:local": "wrangler d1 migrations apply prompt-canary --local",
    "db:remote": "wrangler d1 migrations apply prompt-canary --remote"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "~2.1.8",
    "wrangler": "^4.136.2"
  }
}
